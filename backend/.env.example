# Google Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Postgres connection — match the port in docker-compose.yml
# (default 5432 unless you changed it to avoid a conflict with a native
# Postgres install, e.g. 5433)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/reports

MAX_FILE_SIZE_MB=20
UPLOAD_DIR=./storage/uploads

APP_PASSWORD=changeme
SESSION_SECRET=changeme-session-secret

CORS_ORIGINS=["http://localhost:3000"]
